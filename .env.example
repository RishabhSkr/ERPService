# ============================================================
# MyERP Environment Variables — .env.example
# ============================================================
# Copy this file to .env and fill in the values
# .env is gitignored — NEVER commit actual secrets!
# ============================================================

# ── RabbitMQ ─────────────────────────────────────────────────
# Local Dev (Docker): amqp://guest:guest@rabbitmq:5672/
# Cloud (CloudAMQP):  amqps://user:pass@host/vhost
RABBITMQ_URI=amqp://guest:guest@rabbitmq:5672/

# ── PostgreSQL ────────────────────────────────────────────────
# Local Dev: MyErpPassword123!
# Cloud:     your-secure-cloud-password
PG_PASSWORD=MyErpPassword123!

# ── JWT Secret Key ────────────────────────────────────────────
# Cloud pe yeh ZAROOR change karo!
JWT_KEY=ThisIsASecretKeyForMyERPProject_ChangeThisInProd123!
