## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.
##
*.json
*.yaml
explain_code_flow.md
Properties/
Migrations/
# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# User-specific files (MonoDevelop/Xamarin Studio)
*.userprefs

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww]in32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# Visual Studio 2015/2017 cache/options directory
.vs/
# Visual Studio 2019/2022 cache/options directory
.idea/

# MSTest test Results
[Ee]xporte[Dd]esults/
[Rr]esults/

# NUnit
*.VisualState.xml
TestResult.xml
nunit-*.xml

# Build Results of an ATL Project
[Dd]ebugPS/
[Rr]eleasePS/
dlldata.c

# Benchmark Results
BenchmarkDotNet.Artifacts/

# .NET Core
project.lock.json
project.fragment.lock.json
artifacts/

# ASP.NET Scaffolding
ScaffoldingReadMe.txt

# StyleCop
StyleCopReport.xml

# FxCop
FxCopReport.xml

# Service Fabric Backup files
**/*_backup.xml

# Publish Web Output
*.[Pp]ublish.xml
*.azurePubxml
# Note: Comment the next line if you want to checkin your web deploy settings,
# but database connection strings (with potential passwords) will be unencrypted
*.pubxml
*.publishproj

# Microsoft Azure Web App publish settings. Comment the next line if you want to
# checkin your publish settings, but keep the publish profile secrets unencrypted
*.publishsettings

# NuGet Packages
*.nupkg
# The packages folder can be checked in if PackageRestore is disabled or when using
# the strict 'project.json' type of package restore.
# *.nuget/packages/
# packages/
# !packages/build/
# If you opt into using Nuget Package Restore to download them on build,
# then you can uncomment the following line.
# *.nuget/

# Windows Azure Build Output
csx/
*.build.csdef

# Windows Store app package directories and files
AppPackages/
BundleArtifacts/
Package.StoreAssociation.xml
_pkginfo.txt
*.appx
*.appxbundle
*.appxupload

# Visual Studio cache files
# files ending in .cache can be ignored
*.[Cc]ache
# but keep track of directories ending in .cache
!*.[Cc]ache/

# Others
ClientBin/
~$*
*~
*.dbmdl
*.dbproj.schemaview
*.jfm
*.pfx
*.publishsettings
orleans.codegen.cs

# Including strong name files can present a security risk
# (https://github.com/github/gitignore/pull/2483#issue-259490424)
# *.snk

# Since there are multiple workflows, see https://github.com/github/gitignore/wiki/FAQ
# for more control over which file patterns are ignored.

# Neovim
*.swp
*.swo

# VS Code
.vscode/

# Brain artifacts
*.log
.gemini/
