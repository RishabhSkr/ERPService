{
  "ConnectionStrings": {
    "DefaultConnection": "Server=127.0.0.1,1434;Database=MyERP_Identity;User Id=sa;Password=MyErpPassword123!;TrustServerCertificate=True;"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information"
    }
  },
  "Jwt": {
    "Key": "ThisIsASecretKeyForMyERPProject_ChangeThisInProd123!",
    "Issuer": "MyERP_Identity",
    "Audience": "MyERP_Clients"
  },
  "ReverseProxy": {
    "Routes": {
      "auth-login-route": {
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/api/auth/login"
        }
      },
      "auth-register-route": {
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/api/auth/register"
        }
      },
      "auth-roles-public-route": {
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/api/auth/roles/public"
        }
      },
      "identity-route": {
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        },
        "AuthorizationPolicy": "authenticated"
      },
      "users-route": {
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/api/users/{**catch-all}"
        },
        "AuthorizationPolicy": "authenticated"
      },
      "roles-route": {
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/api/roles/{**catch-all}"
        },
        "AuthorizationPolicy": "authenticated"
      },
      "permissions-route": {
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/api/permissions/{**catch-all}"
        },
        "AuthorizationPolicy": "authenticated"
      },
      "modules-route": {
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/api/modules/{**catch-all}"
        },
        "AuthorizationPolicy": "authenticated"
      },
      "sales-route": {
        "ClusterId": "sales-cluster",
        "Match": {
          "Path": "/api/sales/{**catch-all}"
        },
        "AuthorizationPolicy": "authenticated"
      },
      "inventory-route": {
        "ClusterId": "inventory-cluster",
        "Match": {
          "Path": "/api/inventory/{**catch-all}"
        },
        "AuthorizationPolicy": "authenticated"
      },
      "production-route": {
        "ClusterId": "production-cluster",
        "Match": {
          "Path": "/api/production/{**catch-all}"
        },
        "AuthorizationPolicy": "authenticated"
      }
    },
    "Clusters": {
      "identity-cluster": {
        "HttpRequest": { "ActivityTimeout": "00:02:00" },
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5205/"
          }
        }
      },
      "sales-cluster": {
        "HttpRequest": { "ActivityTimeout": "00:02:00" },
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5002/"
          }
        }
      },
      "inventory-cluster": {
        "HttpRequest": { "ActivityTimeout": "00:02:00" },
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5004/"
          }
        }
      },
      "production-cluster": {
        "HttpRequest": { "ActivityTimeout": "00:02:00" },
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5006/"
          }
        }
      }
    }
  }
}